# Copy to /opt/erpnext/.env on kvm4 and fill in. Never commit the real .env.
# Stock image until the orion custom app lands; then ERPNEXT_IMAGE switches to
# the layered image built by CI (apps.json = erpnext, hrms, orion).
ERPNEXT_IMAGE=frappe/erpnext
ERPNEXT_VERSION=v16.30.0
DB_PASSWORD=change-me
